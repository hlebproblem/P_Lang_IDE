<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        
        
        
        Title="Plang IDE" Height="450" Width="800"
        Background="#121314"
        SizeChanged="Window_SizeChanged"
        PreviewMouseMove="Mouse_Moved">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <avalonEdit:TextEditor Name="codeArea"
                               
                               Grid.Row="0"
                               VerticalAlignment="Top"
                               
                               ShowLineNumbers="True"
                               HorizontalScrollBarVisibility="Hidden"/>
        <Rectangle x:Name="verticalStretchRectangle"
                   
                   Height="5"
                   Grid.Row="1"
                   Fill="Red"
                   VerticalAlignment="Top"
                   Cursor="ScrollNS"
                   
                   MouseLeftButtonDown="VerticalRectangle_MouseDown"
                   MouseLeftButtonUp="VerticalRectangle_MouseUp"/> <!--MouseMove="VerticalRectangle_MouseMove"-->
        <avalonEdit:TextEditor Name="outputArea"
                               
                               Grid.Row="2"
                               VerticalAlignment="Top"/>
    </Grid>
</Window>
